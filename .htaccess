ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.landrytchouela\.com$ [NC]
RewriteRule ^ https://landrytchouela.com%{REQUEST_URI} [L,R=301]
RewriteRule (^|/)\.git(/|$) - [F,L]
# Anciennes pages du Website Builder
RewriteRule ^(portfolio|skills|contact)/?$ / [L,R=301]
RewriteRule ^fr(/.*)?$ /?lang=fr [L,R=301]
</IfModule>

<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
<FilesMatch "\.(png|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
